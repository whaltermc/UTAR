<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Utar" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/utar_background</item>
        <item name="android:statusBarColor">@color/utar_background</item>
        <item name="android:navigationBarColor">@color/utar_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        Godot blocks the game activity's UI thread while it indexes the pack. Disabling the
        window preview keeps the launcher's animated "starting" screen visible during that time
        instead of a frozen black window. (values-v31 also makes the Android 12+ splash transparent.)
    -->
    <style name="Theme.Utar.Game" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/utar_background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
