<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false" />

    <application
        android:name=".UtarApp"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Utar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The engine gets its own process: Godot 4.1 indexes the pack on the UI thread, which
            blocks that thread for as long as it takes. In a separate process the launcher stays
            responsive and keeps animating its "starting" screen meanwhile. The game theme turns
            off the system's starting window so that screen is not covered by a black preview.
        -->
        <activity
            android:name=".GameActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":godot"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Utar.Game" />

    </application>

</manifest>
